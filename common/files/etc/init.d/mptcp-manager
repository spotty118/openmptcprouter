#!/bin/sh /etc/rc.common
# MPTCP Manager Service - Intelligent path management for OpenMPTCProuter
# Starts both metrics exporter and path manager daemons

START=99
STOP=10

USE_PROCD=1

STATE_DIR="/var/run/mptcp-paths"
METRICS_DIR="/var/run/mptcp-metrics"

# Verify MPTCP is available in kernel
verify_mptcp() {
    # Check for MPTCP sysctl (try both old and new naming)
    if [ -f /proc/sys/net/mptcp/enabled ]; then
        return 0
    elif [ -f /proc/sys/net/mptcp/mptcp_enabled ]; then
        return 0
    fi
    return 1
}

# Check if required binaries exist
check_binaries() {
    local missing=0
    if [ ! -x /usr/bin/mptcp-metrics-exporter ]; then
        logger -t mptcp-manager -p daemon.err "ERROR: /usr/bin/mptcp-metrics-exporter not found or not executable"
        missing=1
    fi
    if [ ! -x /usr/bin/mptcp-path-manager ]; then
        logger -t mptcp-manager -p daemon.err "ERROR: /usr/bin/mptcp-path-manager not found or not executable"
        missing=1
    fi
    return $missing
}

start_service() {
    # Check binaries exist
    if ! check_binaries; then
        logger -t mptcp-manager -p daemon.err "Cannot start - required binaries missing"
        return 1
    fi

    # Verify MPTCP availability before starting
    if ! verify_mptcp; then
        logger -t mptcp-manager -p daemon.warning "WARNING: MPTCP not available in kernel - bonding may not work"
        logger -t mptcp-manager -p daemon.warning "Ensure you're using an MPTCP-enabled kernel (check /proc/sys/net/mptcp/enabled)"
        logger -t mptcp-manager -p daemon.warning "Path management will still run but MPTCP subflows won't function"
    else
        # Log MPTCP enabled state
        local mptcp_enabled=0
        [ -f /proc/sys/net/mptcp/enabled ] && mptcp_enabled=$(cat /proc/sys/net/mptcp/enabled)
        [ -f /proc/sys/net/mptcp/mptcp_enabled ] && mptcp_enabled=$(cat /proc/sys/net/mptcp/mptcp_enabled)
        if [ "$mptcp_enabled" = "1" ]; then
            logger -t mptcp-manager -p daemon.info "MPTCP kernel support detected and enabled"
        else
            logger -t mptcp-manager -p daemon.warning "MPTCP kernel support detected but DISABLED (enable via sysctl)"
        fi
    fi

    # Create state directories
    mkdir -p "$STATE_DIR" "$METRICS_DIR"

    # Clean up stale state files from previous runs
    # This ensures a fresh start without leftover penalty states
    rm -rf /var/run/mptcp-paths/*.tmp.* 2>/dev/null
    rm -rf /var/run/mptcp-metrics/*.prev 2>/dev/null
    logger -t mptcp-manager -p daemon.info "Cleaned up stale state files"

    # Start metrics exporter
    procd_open_instance metrics-exporter
    procd_set_param command /usr/bin/mptcp-metrics-exporter
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
    procd_close_instance

    # Start path manager (depends on metrics)
    procd_open_instance path-manager
    procd_set_param command /usr/bin/mptcp-path-manager
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
    procd_close_instance

    logger -t mptcp-manager "MPTCP intelligent path management started"
}

stop_service() {
    logger -t mptcp-manager "MPTCP intelligent path management stopping"

    # Clean up state files to prevent stale data on restart
    # Keep metrics for debugging but clear volatile state
    rm -f "$STATE_DIR"/*.blacklist 2>/dev/null
    rm -f "$STATE_DIR"/*.degraded 2>/dev/null
    rm -f "$STATE_DIR"/*.penalty_* 2>/dev/null

    logger -t mptcp-manager "MPTCP intelligent path management stopped (state cleared)"
}

service_triggers() {
    procd_add_reload_trigger "network"
}

# Status helper
status_service() {
    if [ -x /usr/bin/omr-mptcp-status ]; then
        /usr/bin/omr-mptcp-status
    else
        echo "MPTCP Manager service"
        if pgrep -f mptcp-path-manager >/dev/null 2>&1; then
            echo "  path-manager: running"
        else
            echo "  path-manager: stopped"
        fi
        if pgrep -f mptcp-metrics-exporter >/dev/null 2>&1; then
            echo "  metrics-exporter: running"
        else
            echo "  metrics-exporter: stopped"
        fi
    fi
}
