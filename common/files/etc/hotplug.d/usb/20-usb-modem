#!/bin/sh
# USB modem hotplug handler
# Automatically configures USB modems as additional WANs when plugged in

[ "$ACTION" = "add" ] || exit 0

# Lock to prevent race conditions when multiple devices are plugged in
LOCK_FILE="/var/run/usb-modem-hotplug.lock"
LOCK_TIMEOUT=60

# Try to acquire lock with timeout
acquire_lock() {
    local count=0
    while [ $count -lt $LOCK_TIMEOUT ]; do
        if mkdir "$LOCK_FILE" 2>/dev/null; then
            # Write PID for debugging
            echo $$ > "$LOCK_FILE/pid"
            return 0
        fi
        sleep 1
        count=$((count + 1))
    done
    logger -t usb-modem-hotplug "Failed to acquire lock after ${LOCK_TIMEOUT}s"
    return 1
}

release_lock() {
    rm -rf "$LOCK_FILE"
}

# Ensure lock is released on exit
trap release_lock EXIT

# Try to acquire lock
if ! acquire_lock; then
    exit 1
fi

# Only handle USB network devices and modems
case "$DEVTYPE" in
    usb_interface|usb_device)
        # Check if this is a modem-related device
        case "$PRODUCT" in
            # Quectel modems
            2c7c/*)
                logger -t usb-modem-hotplug "Quectel modem detected: $PRODUCT"
                ;;
            # Huawei modems
            12d1/*)
                logger -t usb-modem-hotplug "Huawei modem detected: $PRODUCT"
                ;;
            # Sierra Wireless
            1199/*)
                logger -t usb-modem-hotplug "Sierra Wireless modem detected: $PRODUCT"
                ;;
            # ZTE modems
            19d2/*)
                logger -t usb-modem-hotplug "ZTE modem detected: $PRODUCT"
                ;;
            # SIMCom modems
            1e0e/*)
                logger -t usb-modem-hotplug "SIMCom modem detected: $PRODUCT"
                ;;
            # Fibocom modems
            2cb7/*)
                logger -t usb-modem-hotplug "Fibocom modem detected: $PRODUCT"
                ;;
            # Telit modems
            1bc7/*)
                logger -t usb-modem-hotplug "Telit modem detected: $PRODUCT"
                ;;
            # MediaTek modems (Fibocom FM350-GL)
            0e8d/*)
                logger -t usb-modem-hotplug "MediaTek/Fibocom modem detected: $PRODUCT"
                ;;
            *)
                # Not a known modem, skip
                exit 0
                ;;
        esac

        # Wait for device to fully enumerate with adaptive timeout
        # FIX: Wait for actual network interfaces, not just USB device path
        # This prevents autoconfig from running before modem interfaces appear
        local net_ready=0
        for i in $(seq 1 20); do
            # Check for modem network interfaces (wwan*, usb*, cdc-wdm*)
            if ls /sys/class/net/wwan* /sys/class/net/usb* /dev/cdc-wdm* 2>/dev/null | grep -q .; then
                net_ready=1
                break
            fi
            sleep 0.5
        done

        if [ $net_ready -eq 0 ]; then
            logger -t usb-modem-hotplug "WARNING: Modem network interfaces not ready after 10s"
        fi

        # Run USB modem auto-config with lock to prevent race conditions
        # Multiple rapid plug/unplug events could spawn duplicate configs
        if [ -x /usr/bin/usb-modem-autoconfig.sh ]; then
            LOCK_FILE="/var/lock/usb-modem-autoconfig.lock"
            (
                # Non-blocking lock - exit if another instance is running
                flock -n 200 || exit 0
                /usr/bin/usb-modem-autoconfig.sh
            ) 200>"$LOCK_FILE" &
        fi
        ;;
esac

exit 0
