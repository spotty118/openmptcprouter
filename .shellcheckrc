# ShellCheck configuration for OpenMPTCProuter
# See: https://github.com/koalaman/shellcheck/wiki/Directive

# Default shell for scripts without shebang
shell=sh

# Exclude common patterns that are intentional
# SC2034: Unused variables (often exported for other scripts)
# SC1090: Can't follow non-constant source (dynamic sourcing is intentional)
# SC1091: Not following sourced file (external files may not exist during check)
disable=SC2034,SC1090,SC1091

# Explicitly enable these checks
enable=require-variable-braces

# Source paths for relative includes
source-path=scripts

# External sources that shellcheck can't resolve
external-sources=true
